{
  "name": "minicode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "chat": "node src/cli/chat.ts",
    "web": "node src/web/main.ts",
    "eval": "node src/eval/main.ts",
    "eval:live": "node src/eval/main.ts --live",
    "eval:world": "node src/eval/main.ts --live --world eval/worlds/xian-3d.json",
    "eval:workflow": "node src/eval/main.ts --arch workflow --world eval/worlds/xian-3d.json",
    "eval:plans": "node src/eval/main.ts --plans",
    "eval:dashboard": "node src/eval/dashboard.ts",
    "eval:compare": "node src/eval/compare.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "eval:tools": "node src/eval/tool-audit.ts",
    "tools:recover": "node src/storage/recover-main.ts"
  },
  "bin": {
    "minicode": "bin/minicode.mjs",
    "minicode-mcp": "bin/minicode-mcp.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
